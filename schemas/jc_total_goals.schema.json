{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://football-betting-oneshot.local/schemas/jc_total_goals.v1.schema.json",
  "title": "Football Betting OneShot official JC total goals v1",
  "description": "Eight-way official JC total-goals projection frozen from the effective Exact distribution.",
  "type": "object",
  "required": [
    "contract_version",
    "status",
    "authority",
    "market_code",
    "market_family",
    "market_name",
    "selection_order",
    "bucket_semantics",
    "buckets",
    "probabilities",
    "top_selection",
    "top_probability",
    "normalization",
    "same_time_official_market_baseline",
    "content_sha256"
  ],
  "properties": {
    "contract_version": {"const": "jc_total_goals.v1"},
    "status": {"const": "FORMAL_JC_TOTAL_GOALS_FROZEN"},
    "authority": {"const": "frozen_effective_exact_distribution"},
    "market_code": {"const": "JC_TOTAL_GOALS"},
    "market_family": {"const": "official_jc_total_goals"},
    "market_name": {"const": "official JC total goals"},
    "selection_order": {
      "const": ["0", "1", "2", "3", "4", "5", "6", "7+"]
    },
    "bucket_semantics": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": {
        "type": "object",
        "required": ["goals", "minimum_total_goals", "maximum_total_goals"],
        "properties": {
          "goals": {"type": "string"},
          "minimum_total_goals": {"type": "integer", "minimum": 0},
          "maximum_total_goals": {"type": ["integer", "null"], "minimum": 0}
        }
      }
    },
    "buckets": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": {
        "type": "object",
        "required": ["goals", "probability"],
        "properties": {
          "goals": {"type": "string"},
          "probability": {"type": "number", "minimum": 0}
        }
      }
    },
    "probabilities": {
      "type": "object",
      "required": ["0", "1", "2", "3", "4", "5", "6", "7+"],
      "properties": {
        "0": {"type": "number", "minimum": 0},
        "1": {"type": "number", "minimum": 0},
        "2": {"type": "number", "minimum": 0},
        "3": {"type": "number", "minimum": 0},
        "4": {"type": "number", "minimum": 0},
        "5": {"type": "number", "minimum": 0},
        "6": {"type": "number", "minimum": 0},
        "7+": {"type": "number", "minimum": 0}
      }
    },
    "top_selection": {"type": "string"},
    "top_probability": {"type": "number", "minimum": 0},
    "normalization": {"type": "object"},
    "same_time_official_market_baseline": {
      "type": "object",
      "required": ["status", "probabilities", "captured_at", "source", "reason", "derived_from_asian_total"],
      "properties": {
        "status": {"const": "NOT_AVAILABLE"},
        "probabilities": {"type": ["object", "null"]},
        "captured_at": {"type": ["string", "null"]},
        "source": {"type": ["string", "null"]},
        "reason": {"type": "string"},
        "derived_from_asian_total": {"const": false}
      }
    },
    "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
