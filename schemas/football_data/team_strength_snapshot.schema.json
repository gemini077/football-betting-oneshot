{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://football-betting-oneshot.local/schemas/football_data/team_strength_snapshot.v1.schema.json",
  "title": "Team strength snapshot v1",
  "allOf": [
    {"$ref": "./football_data_contract.v1.schema.json#/$defs/commonObservation"},
    {
      "type": "object",
      "required": ["contract_version", "team_id", "competition_id", "season_id", "as_of_at", "matches", "window_type", "window_start", "window_end", "minutes", "metrics"],
      "properties": {
        "contract_version": {"const": "team_strength_snapshot.v1"},
        "team_id": {"type": "string", "minLength": 1},
        "competition_id": {"type": ["string", "null"]},
        "season_id": {"type": ["string", "null"]},
        "as_of_at": {"type": "string", "format": "date-time"},
        "matches": {"type": "integer", "minimum": 0},
        "window_type": {"enum": ["last_5", "last_10", "last_20", "season_to_date", "rolling_365d", "single_match"]},
        "window_start": {"type": "string"},
        "window_end": {"type": "string"},
        "minutes": {"type": ["integer", "null"], "minimum": 0},
        "metrics": {"type": "object"},
        "red_card_events": {"type": ["integer", "null"], "minimum": 0},
        "minutes_10v11": {"type": ["integer", "null"], "minimum": 0},
        "minutes_11v10": {"type": ["integer", "null"], "minimum": 0},
        "opponent_adjustment": {"type": ["object", "null"]},
        "latest_historical_match_at": {"type": ["string", "null"], "format": "date-time"},
        "history_age_days": {"type": ["number", "null"], "minimum": 0},
        "latest_match_gap_days": {"type": ["number", "null"], "minimum": 0},
        "history_recency_status": {"enum": ["current", "offseason_bridge", "stale", "unknown"]},
        "current_strength_ready": {"type": "boolean"},
        "history_available": {"type": "boolean"},
        "bridge_status": {"type": ["string", "null"]},
        "bridge_from_season": {"type": ["string", "null"]},
        "bridge_reason": {"type": ["string", "null"]},
        "bridge_verification_evidence": {"type": "array"}
      }
    }
  ]
}
