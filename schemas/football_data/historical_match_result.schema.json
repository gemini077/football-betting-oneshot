{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://football-betting-oneshot.local/schemas/football_data/historical_match_result.v1.schema.json",
  "title": "Historical match result v1",
  "type": "object",
  "required": [
    "contract_version",
    "canonical_match_id",
    "competition_id",
    "season_id",
    "home_team_id",
    "away_team_id",
    "kickoff_at",
    "home_goals",
    "away_goals",
    "provider",
    "provider_match_id",
    "source_as_of_at",
    "captured_at",
    "quality",
    "provenance",
    "resolution_status",
    "resolution_method",
    "eligible_for_team_strength",
    "duplicate_status"
  ],
  "properties": {
    "contract_version": {"const": "historical_match_result.v1"},
    "canonical_match_id": {"type": ["string", "null"]},
    "competition_id": {"type": ["string", "null"]},
    "season_id": {"type": ["string", "null"]},
    "home_team_id": {"type": ["string", "null"]},
    "away_team_id": {"type": ["string", "null"]},
    "kickoff_at": {"type": ["string", "null"], "format": "date-time"},
    "home_goals": {"type": ["integer", "null"], "minimum": 0},
    "away_goals": {"type": ["integer", "null"], "minimum": 0},
    "provider": {"type": "string", "minLength": 1},
    "provider_match_id": {"type": ["string", "null"]},
    "source_as_of_at": {"type": ["string", "null"], "format": "date-time"},
    "captured_at": {"type": "string", "format": "date-time"},
    "quality": {"enum": ["A", "B", "C", "D"]},
    "resolution_status": {"enum": ["resolved", "unresolved"]},
    "resolution_method": {"enum": ["provider_id_exact", "existing_crosswalk", "exact_alias", "normalized_alias", "contextual_match", "manual_verified", "unresolved"]},
    "eligible_for_team_strength": {"type": "boolean"},
    "duplicate_status": {"enum": ["unique", "duplicate_same", "possible_duplicate", "duplicate_conflict"]},
    "provenance": {"type": "object"}
  },
  "additionalProperties": true
}
