{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://football-betting-oneshot.local/schemas/jc_handicap.v1.schema.json",
  "title": "Football Betting OneShot official JC handicap v1",
  "description": "Frozen three-way official JC handicap projection from the effective Exact distribution and an exact Sporttery RQSPF line binding.",
  "type": "object",
  "required": [
    "contract_version",
    "status",
    "authority",
    "market_code",
    "market_identity",
    "market_family",
    "market_name",
    "selection_order",
    "forecast_horizon",
    "model_identity",
    "business_date",
    "line",
    "handicap_line",
    "line_semantics",
    "buckets",
    "probabilities",
    "top_selection",
    "top_probability",
    "normalization",
    "source_authority",
    "source_content_sha256",
    "same_time_official_market_baseline",
    "content_sha256"
  ],
  "properties": {
    "contract_version": {"const": "jc_handicap.v1"},
    "status": {"enum": ["FORMAL_JC_HANDICAP_FROZEN", "NOT_AVAILABLE"]},
    "authority": {"type": "string"},
    "market_code": {"const": "JC_HANDICAP"},
    "market_identity": {"const": "JC_HANDICAP_1X2"},
    "market_family": {"const": "official_jc_handicap"},
    "market_name": {"const": "official JC handicap win/draw/loss"},
    "selection_order": {"const": ["home", "draw", "away"]},
    "forecast_horizon": {"type": "string", "minLength": 1},
    "model_identity": {"type": "object"},
    "business_date": {"type": ["string", "null"]},
    "line": {"type": ["integer", "null"]},
    "handicap_line": {"type": ["integer", "null"]},
    "line_semantics": {"type": "object"},
    "buckets": {"type": "array"},
    "probabilities": {
      "type": ["object", "null"],
      "properties": {
        "home": {"type": "number", "minimum": 0},
        "draw": {"type": "number", "minimum": 0},
        "away": {"type": "number", "minimum": 0}
      }
    },
    "top_selection": {"type": ["string", "null"]},
    "top_probability": {"type": ["number", "null"], "minimum": 0},
    "normalization": {"type": "object"},
    "source_authority": {"type": "object"},
    "source_content_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "same_time_official_market_baseline": {"type": "object"},
    "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
