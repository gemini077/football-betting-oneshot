{
  "contract_version": "football_data_coverage_catalog.v1",
  "policy": {
    "minimum_history_matches_per_team": 5,
    "current_max_history_age_days": 60,
    "offseason_bridge_max_history_age_days": 180,
    "partial_current_season_is_warning_when_history_is_current": true,
    "identity_policy": "exact_reviewed_only"
  },
