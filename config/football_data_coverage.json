      "commercial_use_review": "source_terms_review_required",
      "raw_redistribution": false,
      "internal_analysis_only": true
    },
    "openfootball": {
      "adapter": "scripts.football_data.providers.openfootball.OpenFootballHistoricalAdapter",
      "automatic_import": true,
      "source_quality": "CC0_source_with_identity_review",
      "commercial_use_review": "CC0_with_attribution_review",
      "raw_redistribution": true,
      "internal_analysis_only": false
    },
    "sporttery": {
      "adapter": null,
